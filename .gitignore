# Deny-by-default: ignore everything, then allow specific files below.
*

# Allow descending into subdirectories (required before allowing files).
!*/

# Julia source & package metadata
!*.jl
!*.toml
!CITATION.cff

# Vendored front end of anywidget-instruments-industrial, with the base schema
# of the anywidget-instruments core (see assets/SOURCE.toml)
!assets/index.js
!assets/index.css
!assets/contract.json
!assets/schema/*.json
!assets/templates/*.svg
!assets/LICENSE-anywidget-instruments
!assets/LICENSE-anywidget-instruments-industrial

# Parity cases shared with anywidget-instruments-industrial
!test/parity/*.json

# Docs & repo metadata, named one by one
!README.md
!CHANGELOG.md
!ROADMAP.md
!CODE_OF_CONDUCT.md
!SECURITY.md
!LICENSE.md
!docs/src/*.md
!docs/src/assets/*.png
!.gitignore

# Tooling configs
!.github/**/*.yml
!scripts/*.sh
!justfile

# Re-ignore Julia / docs build artifacts (overrides the allow list above).
Manifest.toml
Manifest-v*.toml
/docs/build/
*.jl.cov
*.jl.*.cov
*.jl.mem
lcov.info

# Agent and specification working files are never versioned.
CLAUDE.md
AGENTS.md
spec.md
.agent/
.claude/
.specify/
specs/

# Editor / OS / env files.
.vscode/
.idea/
.DS_Store
.env
.env.local
